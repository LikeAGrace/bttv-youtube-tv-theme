/* YT TV Lyrics - YouTube TV styled lyrics for Better Lyrics */
$placement: right; // left | right
$accent: #ff0033;
$album-cover-border-radius: 1.25rem;

@import url("https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap");

:root {
    --yttv-bg: #0f0f0f;
    --yttv-h-padding: 7vw;
    --yttv-v-padding: 8vh;
    --ytmusic-player-page-horizontal-padding: 7vw;
    --ytmusic-player-page-vertical-padding: 8vh;

    --blyrics-font-size: 4.2rem;
    --blyrics-line-height: 1.2;
    --blyrics-padding: 1.4rem;
    --blyrics-lyric-active-color: #fff;
    --blyrics-lyric-inactive-color: rgba(255, 255, 255, 0.32);
    --blyrics-active-opacity: 1;
    --blyrics-inactive-opacity: 0.32;
    --blyrics-fullscreen-video-panel-size: 40%;
}

ytmusic-app,
ytmusic-player-page,
.blyrics-container,
.blyrics-container * {
    font-family: "YouTube Sans", Roboto, "Noto Sans", system-ui, sans-serif !important;
}

/* ---------- Lyrics: bold, left aligned, focus on the current line ---------- */
.blyrics-container {
    font-weight: 800;
    text-align: left;
    letter-spacing: -0.01em;

    .blyrics--line {
        transform-origin: left center;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
    }

    .blyrics--word:after {
        text-shadow: none;
    }
}

/* ---------- Full-screen player ---------- */
ytmusic-player-page[player-fullscreened]:not([blyrics-dfs]) {
    --blyrics-font-size: 6.6rem;
    --blyrics-padding: 2.8rem;
    background: var(--yttv-bg);

    .content.ytmusic-player-page {
        flex-direction: if($placement == left, row, row-reverse);
        padding: 0 var(--yttv-h-padding) !important;
        box-sizing: border-box !important;
        gap: 8vw;
    }

    // Keep lyrics clear of the top and bottom edges: the scroller itself gets the margin
    #side-panel {
        box-sizing: border-box;
        padding: var(--yttv-v-padding) 0 !important;
    }

    #tab-renderer[page-type="MUSIC_PAGE_TYPE_TRACK_LYRICS"] {
        height: 100% !important;
        max-height: calc(100vh - 2 * var(--yttv-v-padding) - var(--ytmusic-nav-bar-height, 64px)) !important;
        mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent) !important;
        -webkit-mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent) !important;
    }

    #main-panel {
        padding: var(--yttv-v-padding) 0 !important;
        box-sizing: border-box;
    }

    // Set the size on the container itself so nothing inherited can beat it
    .blyrics-container {
        --blyrics-font-size: 6.6rem !important;
        --blyrics-line-height: 1.15;

        // Full screen only: hide lines that were already sung (synced lyrics, auto-scroll on)
        &:not(.blyrics-user-scrolling):not([data-sync="none"]) .blyrics--line:not(.blyrics--active):not(.blyrics--active ~ .blyrics--line) {
            opacity: 0 !important;
            transition: transform var(--blyrics-lyric-scroll-duration) var(--blyrics-lyric-scroll-timing-function),
                        opacity 0.2s 0.4s;
        }
    }

    // Bigger cover
    #player.ytmusic-player-page {
        width: min(24vw, 44vh) !important;
        max-width: none !important;
    }

    // Album art: big rounded card with TV-style drop shadow
    #player.ytmusic-player-page,
    .song-media-controls.ytmusic-player {
        border-radius: $album-cover-border-radius;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.65);
    }

    // Track title / artist
    #blyrics-song-info > p {
        font-size: 2.2rem !important;
        font-weight: 700;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    }

    // No lyrics: slide art to the centre and hide the side panel
    &:has(.blyrics-container[data-no-lyrics="true"]) {
        #side-panel {
            opacity: 0;
            transition: opacity 0.2s;
        }
        #main-panel {
            @if $placement == left {
                transform: translateX(calc(50vw - 50% - var(--yttv-h-padding)));
            } @else {
                transform: translateX(calc(-50vw + 50% + var(--yttv-h-padding)));
            }
        }
    }
}

/* ---------- Hide the buttons / progress under the cover ---------- */
#blyrics-fs-controls,
.blyrics-fs-info-actions,
ytmusic-player-page[player-fullscreened] .blyrics-fs-disc ~ #blyrics-fs-controls {
    display: none !important;
}

/* ---------- Transparent chrome ---------- */
#layout {
    ytmusic-player-bar,
    #player-bar-background,
    #mini-guide-background,
    #nav-bar-background {
        background: transparent !important;
    }
    #nav-bar-background {
        backdrop-filter: blur(1rem);
    }
}

ytmusic-app[is-bauhaus-sidenav-enabled] #guide-wrapper.ytmusic-app {
    background: transparent;
}

/* ---------- Red progress bar, TV style ---------- */
ytmusic-player-bar {
    --paper-slider-active-color: $accent;
    --paper-slider-knob-color: $accent;
    --paper-slider-knob-start-color: $accent;
    --paper-slider-pin-color: $accent;
    --paper-slider-secondary-color: rgba(255, 255, 255, 0.3);
    --paper-slider-container-color: rgba(255, 255, 255, 0.2);
}

/* ---------- Footer cards ---------- */
.blyrics-footer__container,
.blyrics-footer__discord,
.blyrics-footer__container.blyrics-footer__unison-card {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    padding: 1rem 2rem;
    transition: background-color 0.15s;

    &:hover {
        background: rgba(255, 255, 255, 0.16);
    }
}
